# Lethe API key (required)
LETHE_API_KEY=change-me-in-production

# Charon HMAC key for obol digests (generate with: openssl rand -hex 32)
CHARON_HMAC_KEY=change-me-in-production

# Public URL for obol audience validation
CHARON_PUBLIC_URL=http://localhost:18484

# Optional: Custom upstream Lethe URL (default: http://lethe:18483 in Docker)
# CHARON_UPSTREAM=http://localhost:18483

# Optional: Custom HTTP listener (default: :18484)
# CHARON_HTTP=:18484

# Optional: Custom admin listener (default: 127.0.0.1:18486)
# CHARON_ADMIN_HTTP=127.0.0.1:18486

# Optional: Data directory (default: ./data)
# CHARON_DATA_DIR=./data
