# Charon + Lethe Configuration
# Copy this file to .env and replace all placeholder values before startup.

# ── Lethe (upstream memory) ──────────────────
# API key configured by the upstream Lethe service. The isolated sibling E2E
# stack reads its matching value from ../lethe/.env.git instead of this file.
LETHE_API_KEY=replace-with-upstream-lethe-api-key

# Charon is fail-closed to versioned memory in this mode.
CHARON_MODE=memory-git

# ── Charon Core ──────────────────────────────
# Generate each secret independently with: openssl rand -hex 32
# Do not reuse one value across authentication and merge authorization.
# Existing installations may temporarily use CHARON_HMAC_KEY as a migration
# fallback, but new deployments should leave it unset and configure all three.
# CHARON_HMAC_KEY=
CHARON_OBOL_HMAC_KEY=
CHARON_OAUTH_HMAC_KEY=
# Configure this same merge value on trusted Lethe as CHARON_HMAC_KEY.
CHARON_MERGE_HMAC_KEY=

# Public URL — used for credential audience validation and OAuth metadata.
CHARON_PUBLIC_URL=https://charon.example.com

# The primary Compose gateway is OAuth-only. Its sibling reviewer gateway is
# hard-coded to Obol auth and binds only to loopback.
CHARON_AUTH_MODE=oauth
CHARON_REVIEWER_PUBLIC_URL=http://127.0.0.1:18486

# ── OAuth (only needed when CHARON_AUTH_MODE=oauth) ──
CHARON_OAUTH_CLIENT_ID=chatgpt-mcp
# ChatGPT uses a per-app callback ID; the legacy exact URI remains supported
# for already-published connectors.
CHARON_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector/oauth/*,https://chatgpt.com/connector_platform_oauth_redirect
CHARON_OAUTH_DEFAULT_USER=           # required principal ID or unique name
# CHARON_OAUTH_GENERATE_PAIRING_SECRET=true  # fresh startup key; primary Compose defaults to true
# CHARON_OAUTH_PAIRING_SECRET=        # optional static 32+ character override when generation is false
# CHARON_OAUTH_ALLOW_AUTHOR_SCOPES=false  # memory-git only; retain memory.branch + memory.commit

# ── Auto-Bootstrap (optional) ─────────────────
# Creates a principal + token on first container start
# CHARON_AUTO_USER=chatgpt
# CHARON_AUTO_PERMISSION=readonly      # readonly | propose | review | write
# "propose" is the author profile; "review" can review/merge but cannot write directly.
# OAuth retains branch/commit only when CHARON_OAUTH_ALLOW_AUTHOR_SCOPES=true.
# CHARON_AUTO_PROJECTS=*               # wildcard for reads; use exact projects for mutation
# CHARON_AUTO_PROJECT=default          # legacy single-project fallback
# CHARON_AUTO_EXPIRES=7d

# ── Bounded operational defaults ──────────────
# CHARON_UPSTREAM=http://host.docker.internal:18485
# CHARON_MAX_REQUEST_BYTES=1048576
# CHARON_MAX_RESULT_BYTES=1048576
# CHARON_MAX_RESULT_COUNT=100
# CHARON_REQUEST_TIMEOUT=10s
# CHARON_HTTP_READ_HEADER_TIMEOUT=10s
# CHARON_HTTP_READ_TIMEOUT=30s
# CHARON_HTTP_IDLE_TIMEOUT=2m
# CHARON_HTTP_SHUTDOWN_TIMEOUT=15s
# CHARON_HTTP_MAX_HEADER_BYTES=1048576
