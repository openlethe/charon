# Charon + Lethe Configuration
# Copy this file to .env and edit, or use as-is for local development.

# ── Lethe (upstream memory) ──────────────────
# Existing API key for the one canonical Lethe service. Charon does not start
# or copy a second Lethe database.
LETHE_API_KEY=replace-with-canonical-lethe-api-key

# ── Charon Core ──────────────────────────────
# HMAC key for obol/OAuth signatures and protected Memory Git merge authorization
# (generate with: openssl rand -hex 32; trusted Lethe receives the same value)
CHARON_HMAC_KEY=

# Public URL — used for obol audience validation and OAuth redirects
CHARON_PUBLIC_URL=http://localhost:18484

# Auth mode: obol (default), oauth (for ChatGPT MCP), none (testing only)
CHARON_AUTH_MODE=obol

# ── OAuth (only needed when CHARON_AUTH_MODE=oauth) ──
CHARON_OAUTH_CLIENT_ID=chatgpt-mcp
# ChatGPT uses a per-app callback ID; the legacy exact URI remains supported
# for already-published connectors.
CHARON_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector/oauth/*,https://chatgpt.com/connector_platform_oauth_redirect
# CHARON_OAUTH_DEFAULT_USER=          # set to principal ID or name for auto-approve

# ── Auto-Bootstrap (optional) ─────────────────
# Creates a principal + token on first container start
# CHARON_AUTO_USER=chatgpt
# CHARON_AUTO_PERMISSION=readonly      # readonly | propose | write
# CHARON_AUTO_PROJECTS=*               # wildcard or comma-separated allowlist
# CHARON_AUTO_PROJECT=default          # legacy single-project fallback
# CHARON_AUTO_EXPIRES=7d

# ── Advanced (usually leave as defaults) ──────
# CHARON_UPSTREAM=http://host.docker.internal:18483
# CHARON_HTTP=:18484
# CHARON_ADMIN_HTTP=127.0.0.1:18486
# CHARON_DATA_DIR=./data
