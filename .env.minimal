# Charon Configuration
# Copy this file to .env and fill in your values
# docker-compose automatically loads .env in the same directory

# ============================================================================
# REQUIRED: Lethe API Key
# Generate with: docker run --rm lethe:local-v0.4 keygen
# ============================================================================

LETHE_API_KEY=lethe_…your-key-here

# ============================================================================
# OPTIONAL: Charon HMAC Key
# If not set, Charon will auto-generate one on first start.
# For production, set this explicitly so it persists across container rebuilds.
# Generate with: openssl rand -hex 32
# ============================================================================

# CHARON_HMAC_KEY=your-64-char-hex-key-here

# ============================================================================
# NETWORKING
# ============================================================================

# Public URL for Obol audience validation
# Local: http://localhost:18484
# Cloudflare Tunnel: https://your-tunnel.trycloudflare.com
CHARON_PUBLIC_URL=http://localhost:18484

# ============================================================================
# OPTIONAL: AUTO-BOOTSTRAP
# Set these to automatically create a principal on first container start.
# If unset, you must create principals manually via docker exec.
# ============================================================================

# Name of the LLM/agent (e.g., chatgpt, claude, cline)
CHARON_AUTO_USER=chatgpt

# Permission level: readonly | propose | write
# readonly = search + read
# propose  = search + read + propose
# write    = search + read + propose + write
CHARON_AUTO_PERMISSION=propose

# Project to grant access to (default: default)
CHARON_AUTO_PROJECT=default

# Directory to mount as /workspace for this agent
# Leave blank or unset for an empty sandbox
# CHARON_AUTO_DIRECTORY=/Users/michaelwyatt/projects/my-app

# Token expiry (default: 7d)
CHARON_AUTO_EXPIRES=7d
