# Minimal local Charon configuration
# Copy to .env and replace every blank value before startup.

LETHE_API_KEY=
CHARON_UPSTREAM=http://host.docker.internal:18485

CHARON_MODE=memory-git
CHARON_AUTH_MODE=oauth
CHARON_PUBLIC_URL=http://127.0.0.1:18484
CHARON_REVIEWER_PUBLIC_URL=http://127.0.0.1:18486

# Generate independently with: openssl rand -hex 32
CHARON_OBOL_HMAC_KEY=
CHARON_OAUTH_HMAC_KEY=
# Configure the same merge value on Lethe as CHARON_MERGE_HMAC_KEY
# (legacy fallback CHARON_HMAC_KEY is still accepted there).
CHARON_MERGE_HMAC_KEY=

# OAuth settings
CHARON_OAUTH_REDIRECT_URIS=
CHARON_OAUTH_DEFAULT_USER=
# CHARON_OAUTH_GENERATE_PAIRING_SECRET=true
# CHARON_OAUTH_PAIRING_SECRET=        # optional static override when generation is false
